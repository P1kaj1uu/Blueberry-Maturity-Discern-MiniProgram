page {
  background: #f7f7f2;
  color: #233b33;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 28rpx;
}
view,
button,
input {
  box-sizing: border-box;
}
button {
  margin: 0;
  padding: 0;
  border-radius: 0;
  font-size: inherit;
  line-height: inherit;
  background: transparent;
  color: inherit;
}
button::after {
  border: none;
}
/* 微信新版基础库给普通按钮预设固定宽度，显式还原以保证布局。 */
button:not([size="mini"]) {
  width: auto;
  margin: 0;
  font-weight: 400;
}
button.primary,
button.secondary {
  font-weight: 500;
}
button.recent-card,
button.record-main {
  width: 100%;
  text-align: left;
}
.page {
  padding: 30rpx 40rpx calc(160rpx + env(safe-area-inset-bottom));
}
.eyebrow {
  font-size: 20rpx;
  letter-spacing: 4rpx;
  color: #788579;
}
.serif {
  font-family: "Songti SC", "Noto Serif CJK SC", "STSong", serif;
}
.page-title {
  font-size: 56rpx;
  line-height: 1.3;
  margin: 18rpx 0 16rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}
.muted {
  color: #7c857b;
}
.icon {
  width: 40rpx;
  height: 40rpx;
  flex-shrink: 0;
}
.primary,
.secondary {
  min-height: 102rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 18rpx;
  font-weight: 500;
}
.primary {
  background: #244e3e;
  color: #fff;
}
.secondary {
  background: #edeee7;
  color: #244e3e;
  border: 1rpx solid #e0e3d9;
}
.press {
  transform: scale(0.96);
  opacity: 0.88;
}
button {
  transition:
    transform 150ms cubic-bezier(0.2, 0, 0, 1),
    opacity 150ms;
}
button[disabled] {
  opacity: 0.48;
}
.section-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 44rpx 0 22rpx;
}
.section-title {
  font-size: 32rpx;
  font-weight: 600;
}
.text-button {
  color: #687a65;
  font-size: 24rpx;
  padding: 14rpx 0 14rpx 18rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
}
.chevron {
  width: 24rpx;
  height: 24rpx;
}
.dot {
  display: inline-block;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  margin-right: 12rpx;
  background: #355987;
}
.dot.unripe {
  background: #b18c4d;
}
.divider {
  height: 1rpx;
  background: #e3e6db;
}
.footer-note {
  text-align: center;
  font-size: 21rpx;
  color: #9a9f91;
  letter-spacing: 2rpx;
  padding-top: 36rpx;
}
.empty {
  padding: 70rpx 30rpx;
  text-align: center;
  border: 1rpx dashed #d5dccd;
  border-radius: 20rpx;
}
.empty-title {
  font-size: 30rpx;
  margin: 20rpx 0 12rpx;
}
.empty-copy {
  color: #818a7b;
  font-size: 24rpx;
  line-height: 1.8;
}
.empty .icon {
  width: 58rpx;
  height: 58rpx;
}
