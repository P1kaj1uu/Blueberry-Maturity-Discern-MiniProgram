.page-title {
  font-size: 49rpx;
  margin-top: 22rpx;
}
.guide-sub {
  font-size: 25rpx;
  color: #7d8875;
  margin: 18rpx 0 30rpx;
}
.guide-photo {
  height: 320rpx;
  position: relative;
  overflow: hidden;
  border-radius: 18rpx;
  outline: 1rpx solid rgba(0, 0, 0, 0.1);
}
.guide-photo image {
  width: 100%;
  height: 100%;
}
.guide-photo::after {
  content: "";
  position: absolute;
  inset: 0;
  background: linear-gradient(transparent 50%, rgba(16, 38, 27, 0.6));
}
.guide-photo text {
  position: absolute;
  bottom: 24rpx;
  left: 0;
  width: 100%;
  text-align: center;
  color: #fff;
  z-index: 1;
  font-size: 22rpx;
  letter-spacing: 2rpx;
}
.frame-corner {
  position: absolute;
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.8);
  z-index: 1;
}
.tl {
  top: 28rpx;
  left: 28rpx;
  border-right: none;
  border-bottom: none;
}
.tr {
  top: 28rpx;
  right: 28rpx;
  border-left: none;
  border-bottom: none;
}
.bl {
  bottom: 68rpx;
  left: 28rpx;
  border-right: none;
  border-top: none;
}
.br {
  bottom: 68rpx;
  right: 28rpx;
  border-left: none;
  border-top: none;
}
.guide-step {
  display: flex;
  gap: 30rpx;
  padding: 32rpx 0;
  border-bottom: 1rpx solid #e1e6d8;
}
.step-number {
  color: #97a48b;
  font-size: 37rpx;
  padding-top: 3rpx;
}
.step-title {
  font-size: 29rpx;
  font-weight: 500;
  margin-bottom: 14rpx;
}
.step-copy {
  font-size: 24rpx;
  color: #819076;
  line-height: 1.85;
}
.reading-note {
  margin: 36rpx 0;
  padding: 30rpx;
  border-radius: 18rpx;
  background: #eaf0e3;
}
.reading-note .section-title {
  font-size: 31rpx;
}
.reading-row {
  display: flex;
  align-items: baseline;
  margin-top: 28rpx;
}
.reading-title {
  display: block;
  font-size: 25rpx;
  margin-bottom: 10rpx;
}
.reading-copy {
  color: #7e8e71;
  font-size: 22rpx;
}
.guide-divider {
  height: 1rpx;
  background: #d5dfca;
  margin: 28rpx 0;
}
.formula {
  font-size: 22rpx;
  font-weight: 500;
}
.formula-note {
  font-size: 21rpx;
  line-height: 1.8;
  margin-top: 16rpx;
  color: #829375;
}
