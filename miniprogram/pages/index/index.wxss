.brand-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 10rpx 0 22rpx;
}
.brand {
  display: flex;
  align-items: center;
  gap: 14rpx;
}
.brand-leaf {
  width: 30rpx;
  height: 30rpx;
}
.brand .serif {
  font-size: 34rpx;
  font-weight: 600;
  letter-spacing: 5rpx;
}
.brand-divider {
  width: 1rpx;
  height: 24rpx;
  background: #cdd5c7;
  margin: 0 2rpx;
}
.brand-sub {
  font-size: 21rpx;
  color: #6d7c69;
}
.field-note {
  font-size: 15rpx;
  letter-spacing: 2rpx;
  color: #85917c;
}
.intro {
  padding: 0px 0 34rpx 16rpx;
}
.intro .page-title {
  font-size: 65rpx;
  line-height: 1.35;
  letter-spacing: 3rpx;
  margin: 0 0 18rpx;
}
.intro-copy {
  color: #7b8477;
  font-size: 25rpx;
  letter-spacing: 1rpx;
}
.hero {
  position: relative;
  height: 450rpx;
  overflow: hidden;
  border-radius: 20rpx;
  background: #344c37;
  outline: 1rpx solid rgba(0, 0, 0, 0.1);
}
.hero-photo,
.hero-shade {
  position: absolute;
  width: 100%;
  height: 100%;
}
.hero-shade {
  background: linear-gradient(
    180deg,
    rgba(12, 28, 22, 0.2),
    transparent 35%,
    rgba(12, 28, 22, 0.66)
  );
}
.hero-top {
  position: absolute;
  top: 26rpx;
  left: 26rpx;
  right: 26rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.hero-tag {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 20rpx;
  color: #fff;
  background: rgba(249, 251, 237, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.35);
  padding: 10rpx 15rpx;
  border-radius: 8rpx;
}
.tiny-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #d9e1bd;
}
.hero-number {
  color: rgba(255, 255, 255, 0.75);
  font-size: 15rpx;
  letter-spacing: 2rpx;
}
.hero-bottom {
  position: absolute;
  bottom: 28rpx;
  left: 28rpx;
  right: 26rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-between;
}
.hero-caption {
  font-size: 30rpx;
  color: #fff;
  letter-spacing: 1rpx;
  white-space: nowrap;
}
.hero-sub {
  color: rgba(255, 255, 255, 0.7);
  font-size: 19rpx;
  margin-top: 12rpx;
}
.sample-button {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 21rpx;
  color: #fff;
  padding: 12rpx 0 12rpx 12rpx;
  flex-shrink: 0;
}
.sample-arrow {
  font-size: 28rpx;
}
.action-row {
  display: flex;
  gap: 18rpx;
  margin-top: 28rpx;
}
.camera-button {
  flex: 1.05;
}
.album-button {
  flex: 1;
}
.upload-note {
  font-size: 19rpx;
  text-align: center;
  color: #93998c;
  margin: 20rpx 0 30rpx;
}
.tip-strip {
  display: flex;
  align-items: center;
  gap: 18rpx;
  background: #eaf0e3;
  border-radius: 12rpx;
  padding: 24rpx 20rpx;
  font-size: 22rpx;
  color: #66785b;
}
.tip-number {
  font-size: 20rpx;
  flex-shrink: 0;
  padding-right: 16rpx;
  border-right: 1rpx solid #cdd8c2;
  color: #385439;
  font-weight: 500;
}
.tip-strip .chevron {
  margin-left: auto;
}
.first-record {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 34rpx 28rpx;
  border: 1rpx dashed #d5dccd;
  border-radius: 16rpx;
  font-size: 26rpx;
}
.first-record .icon {
  opacity: 0.6;
  width: 46rpx;
  height: 46rpx;
}
.first-record text {
  display: block;
  font-size: 22rpx;
  color: #8b9484;
  margin-top: 12rpx;
}
.recent-card {
  display: flex;
  width: 100%;
  text-align: left;
  align-items: center;
  gap: 22rpx;
  padding: 20rpx;
  background: #fff;
  border-radius: 16rpx;
  border: 1rpx solid #e7eadf;
}
.recent-photo {
  width: 116rpx;
  height: 126rpx;
  border-radius: 10rpx;
  flex-shrink: 0;
}
.recent-info {
  flex: 1;
}
.recent-title {
  font-size: 25rpx;
  font-weight: 500;
}
.recent-date {
  font-size: 20rpx;
  color: #91968b;
  margin-top: 10rpx;
}
.recent-count {
  display: flex;
  gap: 20rpx;
  margin-top: 14rpx;
  font-size: 19rpx;
  color: #72806d;
}
.recent-count .dot {
  width: 9rpx;
  height: 9rpx;
  margin-right: 7rpx;
}
.recent-ratio {
  text-align: right;
  font-size: 38rpx;
  font-weight: 600;
}
.recent-ratio .percent {
  font-size: 20rpx;
}
.recent-ratio view {
  font-size: 18rpx;
  color: #8c9485;
  font-weight: 400;
  margin-top: 8rpx;
}
.state-copy {
  font-size: 26rpx;
  line-height: 1.8;
  margin-top: 20rpx;
}
.loading-photo-wrap {
  position: relative;
  background: #eceee5;
  border-radius: 20rpx;
  overflow: hidden;
  margin: 36rpx 0;
}
.loading-photo {
  display: block;
  width: 100%;
  height: 550rpx;
}
.loading-badge {
  position: absolute;
  bottom: 30rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  gap: 14rpx;
  background: #f7f7f2;
  padding: 18rpx 26rpx;
  border-radius: 12rpx;
  white-space: nowrap;
  font-size: 24rpx;
}
.loading-dot {
  width: 14rpx;
  height: 14rpx;
  background: #57784b;
  border-radius: 50%;
}
.loading-status {
  color: #8a9382;
  font-size: 23rpx;
  text-align: center;
  margin: 30rpx 0 40rpx;
}
.progress-track {
  height: 6rpx;
  background: #e2e7d9;
  margin-bottom: 22rpx;
  border-radius: 3rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: #58754b;
  transition: width 150ms ease-out;
}
.state-back {
  margin-top: 20rpx;
}
.result-heading {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.result-heading .page-title {
  font-size: 40rpx;
  margin-top: 22rpx;
  white-space: nowrap;
}
.close-button {
  padding: 16rpx;
  margin-right: -16rpx;
}
.result-sub {
  font-size: 25rpx;
  color: #7d8877;
  line-height: 1.7;
}
.photo-tools {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin: 24rpx 0 8rpx;
}
.legend {
  display: flex;
  gap: 30rpx;
  font-size: 22rpx;
  color: #6b7965;
}
.detection-photo {
  position: relative;
  width: 100%;
  background: #eceee5;
  border-radius: 16rpx;
  overflow: hidden;
  outline: 1rpx solid rgba(0, 0, 0, 0.1);
}
.result-photo {
  position: absolute;
  width: 100%;
  height: 100%;
}
.berry-box {
  position: absolute;
  border: 3rpx solid #6fa4db;
  background: rgba(61, 107, 162, 0.05);
  z-index: 2;
}
.berry-box.immature {
  border-color: #dfb562;
  background: rgba(184, 142, 65, 0.06);
}
.berry-label {
  position: absolute;
  top: 0;
  left: 0;
  background: #355f91;
  color: #fff;
  font-size: 19rpx;
  line-height: 1.3;
  padding: 3rpx 7rpx;
  border-radius: 0 0 4rpx 0;
  white-space: nowrap;
}
.immature .berry-label {
  background: #92702d;
}
.berry-box.selected {
  z-index: 5;
  border-width: 5rpx;
  background: rgba(255, 255, 255, 0.15);
}
.photo-hint {
  font-size: 19rpx;
  color: #92998b;
  text-align: center;
  margin: 20rpx 0 28rpx;
}
.summary-card {
  background: #edf1e6;
  border-radius: 18rpx;
  padding: 32rpx;
}
.summary-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
}
.summary-top .eyebrow {
  font-size: 23rpx;
  letter-spacing: 1rpx;
}
.ratio-number {
  font-family: Georgia, serif;
  font-size: 96rpx;
  line-height: 1.15;
  margin-top: 10rpx;
}
.ratio-number text {
  font-size: 37rpx;
  margin-left: 5rpx;
}
.summary-aside {
  text-align: right;
}
.summary-leaf {
  font-size: 28rpx;
  color: #5d7755;
}
.summary-aside view {
  font-size: 19rpx;
  color: #8b977f;
  margin-top: 16rpx;
}
.ratio-track {
  background: #ddd3b7;
  height: 10rpx;
  border-radius: 5rpx;
  overflow: hidden;
  margin: 26rpx 0 30rpx;
}
.ratio-fill {
  background: #355f91;
  height: 100%;
}
.counts {
  display: flex;
}
.counts > view {
  flex: 1;
  border-right: 1rpx solid #d4ddc8;
  padding-left: 24rpx;
}
.counts > view:first-child {
  padding-left: 0;
}
.counts > view:last-child {
  border: none;
}
.count-number {
  display: block;
  font-size: 45rpx;
  font-weight: 600;
  line-height: 1.2;
}
.count-label {
  display: block;
  font-size: 20rpx;
  color: #7d8b70;
  margin-top: 12rpx;
}
.count-label .dot {
  width: 10rpx;
  height: 10rpx;
  margin-right: 7rpx;
}
.mature-text {
  color: #355f91;
}
.immature-text {
  color: #99783c;
}
.filter-row {
  display: flex;
  gap: 14rpx;
  margin: 36rpx 0 22rpx;
}
.filter {
  padding: 15rpx 26rpx;
  font-size: 23rpx;
  border-radius: 10rpx;
  color: #7a8771;
  background: #e9ece3;
}
.filter.chosen {
  background: #244e3e;
  color: #fff;
}
.berry-list {
  border-top: 1rpx solid #e1e6d9;
  max-height: 520rpx;
  overflow-y: auto;
}
.berry-row {
  display: flex;
  align-items: center;
  padding: 26rpx 12rpx;
  border-bottom: 1rpx solid #e1e6d9;
  font-size: 24rpx;
}
.berry-index {
  color: #9aa18e;
  font-family: Georgia, serif;
  margin-right: 40rpx;
  min-width: 40rpx;
}
.berry-state {
  flex: 1;
}
.confidence {
  font-size: 21rpx;
  color: #8b947f;
}
.row-selected {
  background: #eaf0e1;
}
.no-filter-result {
  padding: 40rpx 0;
  font-size: 25rpx;
  color: #89957b;
  text-align: center;
}
.result-actions {
  display: flex;
  gap: 18rpx;
  margin-top: 36rpx;
}
.result-actions > button {
  flex: 1;
  font-size: 26rpx;
}
.another-photo {
  justify-content: center;
  margin: 20rpx auto;
  padding: 20rpx;
}
.result-note {
  color: #969c8e;
  font-size: 21rpx;
  line-height: 1.8;
  text-align: center;
}
.export-canvas {
  position: fixed;
  left: -10000px;
  top: -10000px;
  width: 1px;
  height: 1px;
}
